# OSCC Health Intelligence - environment variables (NFR-SEC-09).
# Copy to infrastructure/.env for local development:  cp infrastructure/.env.example infrastructure/.env
# The values below are DEVELOPMENT-ONLY placeholders for the local Docker stack.
# Production values are set on the server and are never committed.
# Every variable read by any service must be listed here (enforced by api/tests/test_config.py).

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL 16 + pgvector (db service) ---
POSTGRES_DB=oscc
POSTGRES_USER=oscc
POSTGRES_PASSWORD=dev-only-change-me
DATABASE_URL=postgresql+asyncpg://oscc:dev-only-change-me@db:5432/oscc

# --- S3-compatible object storage (SeaweedFS in development) ---
# STORAGE_ENDPOINT_URL is used container-to-container; STORAGE_PUBLIC_ENDPOINT_URL is the host
# the browser uses, and signed URLs are signed for it.
STORAGE_ENDPOINT_URL=http://storage:8333
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=oscc-private
STORAGE_ACCESS_KEY_ID=dev-only-access-key
STORAGE_SECRET_ACCESS_KEY=dev-only-secret-key-change-me
# Signed URL lifetime in seconds; must be <= 600 (NFR-SEC-06).
STORAGE_SIGNED_URL_TTL_SECONDS=600

# --- Internal services ---
INFERENCE_URL=http://inference:8001
READINESS_TIMEOUT_SECONDS=2.0

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=60
WORKER_HEARTBEAT_FILE=/tmp/oscc-worker-heartbeat

# --- Front end (Vite dev server) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
